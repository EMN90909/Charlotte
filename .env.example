# ==========================================
# CHARLOTTE DESKTOP BROWSER ENVIRONMENT CONFIG
# ==========================================

# Charlotte Cloud Server Connectivity
CHARLOTTE_CLOUD_HTTP=http://localhost:8080
CHARLOTTE_CLOUD_WS=ws://localhost:8080/ws
# For production hosted cloud:
# CHARLOTTE_CLOUD_HTTP=https://api.charlotte.noethric.xyz
# CHARLOTTE_CLOUD_WS=wss://api.charlotte.noethric.xyz/ws

# ------------------------------------------
# EXTERNAL LLM PROVIDER API KEYS
# ------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------
# UNIFIED GOOGLE CREDENTIALS ("G-keys")
# ------------------------------------------
G_KEYS={"client_id":"your-client-id.apps.googleusercontent.com","client_secret":"your-client-secret","refresh_token":"your-refresh-token","api_key":"your-api-key"}

# ------------------------------------------
# SUPABASE STORAGE & CHECKPOINTS
# ------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# ------------------------------------------
# E2B CLOUD COMPUTER ISOLATED SANDBOX
# ------------------------------------------
E2B_API_KEY=your-e2b-api-key
