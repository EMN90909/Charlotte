# Keep GitHub's source-language statistics focused on authored source.
*.rs linguist-language=Rust
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
*.go linguist-language=Go
*.js linguist-language=JavaScript
*.mjs linguist-language=JavaScript
*.css linguist-language=CSS
*.sh linguist-language=Shell
*.proto linguist-language=Protocol Buffer
*.rb linguist-language=Ruby

server/gen/** linguist-generated=true
website/package-lock.json linguist-generated=true
brand/export/** linguist-generated=true
