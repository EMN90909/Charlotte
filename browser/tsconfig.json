{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "strict": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM"
    ]
  },
  "include": [
    "src",
    "forge.env.d.ts"
  ],
  "exclude": [
    "src/main/adblock/tests",
    "src/main/adblock/tsup.config.ts",
    "src/main/adblock/vitest.config.ts"
  ]
}
