# Public Supabase project configuration only; never add service-role keys.
CHARLOTTE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
CHARLOTTE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Optional Charlotte chat service:
CHARLOTTE_CHAT_SERVER=http://127.0.0.1:8080
# Optional native profile override:
# CHARLOTTE_PROFILE_DIR=/home/user/.charlotte
# Optional start page:
# CHARLOTTE_START_URL=https://example.com
