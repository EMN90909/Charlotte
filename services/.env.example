# Copy to services/.env; NEVER commit real keys. Managed hosting: set in secret manager.
HOST=127.0.0.1
PORT=8087
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
USER_REQUESTS_PER_HOUR=60

# 13 model providers. Configure only the ones Charlotte will serve.
# A model is offered only when its provider has >=1 valid server-side key.
# Optional rotation: OPENAI_API_KEY_1, OPENAI_API_KEY_2 or OPENAI_API_KEYS=key1,key2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
PERPLEXITY_API_KEY=

# Whitelist models explicitly in production (over 20 candidate chat model IDs shown):
# If blank, enabledModels() advertises all curated models for configured providers.
CLOUD_ENABLED_MODELS=openai/gpt-6-luna,openai/gpt-6.1-sol,openai/gpt-6.1-terra,openai/gpt-6-astra,openai/gpt-5.6-sol,anthropic/claude-sonnet-5-5,anthropic/claude-haiku-5-5,anthropic/claude-opus-5-5,anthropic/claude-fable-5-1,gemini/gemini-4-argon,gemini/gemini-3.8-flash,gemini/gemini-3.6-flash,gemini/gemini-3.5-flash-lite,xai/grok-4.7,xai/grok-4.6,mistral/mistral-large-latest,mistral/mistral-small-latest,deepseek/deepseek-flash,deepseek/deepseek-v4-pro,groq/openai/gpt-oss-120b,groq/openai/gpt-oss-20b,cohere/command-a-03-2025,cohere/command-a-plus-05-2026,perplexity/sonar,perplexity/sonar-pro

# Releases are OPTIONAL. Without both values /v1/updates/manifest returns available=false.
# Use a private Ed25519 PEM from secret manager, base64-encoded (no literal newlines).
UPDATE_SIGNING_PRIVATE_KEY_PEM_BASE64=
UPDATE_MANIFEST_FILE=./updates/releases.json
UPDATE_ASSET_HOST=downloads.your-charlotte-domain.example
